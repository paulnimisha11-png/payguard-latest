<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Loading -->
    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/checking"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Error -->
    <LinearLayout
        android:id="@+id/errorBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_title"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/dim"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnRetry"
            style="@style/Btn.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:text="@string/retry" />

        <Button
            android:id="@+id/btnErrorSettings"
            style="@style/Btn.Ghost"
            android:layout_width="match_parent"
            android:text="@string/settings" />
    </LinearLayout>

    <!-- Result -->
    <ScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingTop="28dp"
                android:paddingRight="20dp"
                android:paddingBottom="22dp">

                <TextView
                    android:id="@+id/scoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true"
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#FFFFFF"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/advice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#F2FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/special"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:background="@drawable/card"
                android:orientation="vertical"
                android:padding="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="14dp"
                android:paddingRight="16dp">

                <TextView
                    android:id="@+id/countdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingBottom="8dp"
                    android:textColor="@color/ok"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnPrimary"
                    style="@style/Btn.Primary"
                    android:layout_width="match_parent" />

                <Button
                    android:id="@+id/btnSecondary"
                    style="@style/Btn.Ghost"
                    android:layout_width="match_parent"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/overrideRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/card"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/chkOverride"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/override_check"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnOverride"
                        style="@style/Btn.Ghost"
                        android:layout_width="match_parent"
                        android:enabled="false"
                        android:text="@string/pay_anyway" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCopy"
                        style="@style/Btn.Small"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/copy_upi"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnReport"
                        style="@style/Btn.Small.Danger"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/report_scam"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnOpenApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="@string/open_upi_app_hint"
                    android:textColor="@color/brand"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/voteCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/H2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vote_title" />

                    <TextView
                        android:id="@+id/voteCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/dim"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnGotMe"
                        style="@style/Btn.Primary"
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/btn_dark"
                        android:text="@string/vote_got_me" />

                    <Button
                        android:id="@+id/btnFake"
                        style="@style/Btn.Ghost"
                        android:layout_width="match_parent"
                        android:text="@string/vote_fake" />

                    <TextView
                        android:id="@+id/voteMsg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/ok"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/findingsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/what_we_found"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/findings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btnDone"
                    style="@style/Btn.Ghost"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:text="@string/done" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
