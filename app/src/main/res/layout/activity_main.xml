<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="20dp"
        android:paddingRight="16dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSettings"
                style="@style/Btn.Small"
                android:layout_width="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/settings" />
        </LinearLayout>

        <TextView
            android:id="@+id/serverStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp" />

        <!-- Main action -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_pay_title" />

            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/home_pay_body" />

            <Button
                android:id="@+id/btnScan"
                style="@style/Btn.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:minHeight="60dp"
                android:text="@string/scan_to_pay"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnQrPhoto"
                style="@style/Btn.Ghost"
                android:layout_width="match_parent"
                android:text="@string/qr_from_photo" />
        </LinearLayout>

        <!-- Scam message checker -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/msg_card_title" />

            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/msg_card_body" />

            <EditText
                android:id="@+id/msgText"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="top"
                android:hint="@string/msg_hint"
                android:inputType="textMultiLine|textNoSuggestions"
                android:maxLength="20000"
                android:minLines="3" />

            <Button
                android:id="@+id/btnCheckMsg"
                style="@style/Btn.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="@string/check_message" />

            <Button
                android:id="@+id/btnPasteMsg"
                style="@style/Btn.Ghost"
                android:layout_width="match_parent"
                android:text="@string/paste_and_check" />
        </LinearLayout>

        <!-- Family protection + trends -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/family_card_title" />

            <TextView
                android:id="@+id/famStatus"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/family_card_body" />

            <Button
                android:id="@+id/btnFamily"
                style="@style/Btn.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="@string/open_family" />

            <Button
                android:id="@+id/btnTrends"
                style="@style/Btn.Ghost"
                android:layout_width="match_parent"
                android:text="@string/open_trends" />
        </LinearLayout>

        <!-- UPI interceptor setup -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guard_title" />

            <TextView
                android:id="@+id/defaultStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/guard_body" />

            <Button
                android:id="@+id/btnMakeDefault"
                style="@style/Btn.Ghost"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="@string/make_default" />
        </LinearLayout>

        <!-- Screenshot -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shot_title" />

            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/shot_body" />

            <EditText
                android:id="@+id/expected"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/expected_hint"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/bankSms"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="top"
                android:hint="@string/bank_sms_hint"
                android:inputType="textMultiLine"
                android:maxLength="2000"
                android:minLines="2"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnShot"
                style="@style/Btn.Ghost"
                android:layout_width="match_parent"
                android:text="@string/check_shot" />
        </LinearLayout>

        <!-- Link / APK -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/other_title" />

            <EditText
                android:id="@+id/paste"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:hint="@string/paste_hint"
                android:inputType="textUri"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnCheckPaste"
                style="@style/Btn.Ghost"
                android:layout_width="match_parent"
                android:text="@string/check_link" />

            <Button
                android:id="@+id/btnApk"
                style="@style/Btn.Ghost"
                android:layout_width="match_parent"
                android:text="@string/check_apk" />

            <Button
                android:id="@+id/btnWebsite"
                style="@style/Btn.Small"
                android:layout_width="match_parent"
                android:layout_marginRight="0dp"
                android:text="@string/open_website" />
        </LinearLayout>

        <TextView
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/helpline" />
    </LinearLayout>
</ScrollView>
