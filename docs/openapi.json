   "ComplaintIn": {
    "properties": {
     "source": {
      "type": "string",
      "enum": [
       "apk",
       "qr",
       "screenshot",
       "message"
      ],
      "title": "Source"
     },
     "sha256": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Sha256",
      "description": "APK scan to report"
     },
     "payload": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 5000
       },
       {
        "type": "null"
       }
      ],
      "title": "Payload",
      "description": "QR/UPI/link content, or the scam message text, to report"
     },
     "lang": {
      "type": "string",
      "enum": [
       "en",
       "hi",
       "kn",
       "ta",
       "te",
       "mr",
       "bn"
      ],
      "title": "Lang",
      "default": "en"
     },
