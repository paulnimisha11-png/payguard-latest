      "items": {
       "type": "string"
      },
      "type": "array",
      "maxItems": 5,
      "title": "Transaction Ids"
     },
     "payment_method": {
      "anyOf": [
       {
        "type": "string",
        "enum": [
         "upi",
         "card",
         "netbanking",
         "wallet",
         "other"
        ]
       },
       {
        "type": "null"
       }
      ],
      "title": "Payment Method"
     },
     "victim_bank": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 80
       },
       {
        "type": "null"
       }
      ],
      "title": "Victim Bank"
     },
     "paid_to": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 120
       },
       {
        "type": "null"
       }
      ],
      "title": "Paid To"
     },
     "channel": {
      "anyOf": [
       {
        "type": "string",
        "enum": [
         "whatsapp",
         "sms",
         "call",
         "email",
         "social",
         "website",
         "in_person",
         "other"
        ]
       },
       {
        "type": "null"
       }
      ],
      "title": "Channel"
     },
     "sender_contact": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 80
       },
       {
        "type": "null"
       }
      ],
      "title": "Sender Contact"
     },
     "app_installed": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "App Installed"
     },
     "description": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 2000
       },
       {
        "type": "null"
       }
      ],
      "title": "Description"
     },
     "victim_name": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 100
       },
       {
        "type": "null"
       }
