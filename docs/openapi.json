      "type": "boolean",
      "title": "Lost Money",
      "default": false
     },
     "amount": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 100000000.0,
        "exclusiveMinimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Amount"
     },
     "incident_time": {
      "anyOf": [
       {
        "type": "string",
        "format": "date-time"
       },
       {
        "type": "null"
       }
      ],
      "title": "Incident Time"
     },
