# PayGuard configuration. Copy to .env (never commit .env) and fill in only what you need.
# Everything is optional: with no variables set, all four scanners work locally.

# --- AI (server-side only; never put keys in the Android app or static/) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_TIMEOUT=25
GEMINI_SMS_TIMEOUT=12
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Threat intelligence ---
SAFE_BROWSING_API_KEY=
SAFE_BROWSING_TIMEOUT=4
VT_API_KEY=

# --- Server / storage ---
PORT=8000
APKXRAY_DB=data/apkxray.db
APKXRAY_MAX_MB=150
APKXRAY_TIMEOUT=120
APKXRAY_RATE_PER_MIN=12
APKXRAY_WORKERS=1
OCR_ENGINE=
APKXRAY_OCR_CONCURRENCY=1
APKXRAY_OCR_STRIP=1100

# --- Community, trends, moderation ---
APKXRAY_VOTE_SALT=change-me-to-a-long-random-string
APKXRAY_PUBLIC_MIN=3
APKXRAY_ADMIN_TOKEN=
APKXRAY_COMPLAINT_TTL_DAYS=30

# --- Family alerts (Web Push) ---
APKXRAY_VAPID_PRIVATE=
APKXRAY_VAPID_SUB=mailto:you@example.com

# --- Accounts (Clerk) and e-mail ---
PUBLIC_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=
DATABASE_URL=
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@payguard.local
MAIL_FROM_NAME=PayGuard

# --- Android app download ---
APKXRAY_APP_APK_URL=
